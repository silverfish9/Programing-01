ball basketball;

void setup(){
  
  size(400,400);


basketball= new Ball(100,100);

}

void draw(){
  
  background(#2771B9);

basketball.display();

}

class ball{
  float x, y;

  ball(float startx, float starty) {
    x = startx;
    y = starty;
  }

  void display(){
    ellipse(x, y, 20, 20);
  }
}
